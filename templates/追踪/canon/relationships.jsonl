# Schema: {"id":"REL-XXXX","chapter":N,"from":"角色A","to":"角色B","status":"关系状态","delta":"变化描述","sentiment":-3..3}
# sentiment: -3=敌对, -2=厌恶, -1=冷淡, 0=中立, 1=友善, 2=亲近, 3=亲密
# 每章归档时追加，记录角色间情感状态变化
# arc: 角色弧线标签（如"{角色名}-信任建立"），同一弧线跨章追踪情感渐进；L2 卷级摘要汇总各 arc 进展
# 示例条目（使用时替换为实际内容，或删除示例从头开始）：
# {"id":"REL-0001","chapter":1,"from":"{主角名}","to":"{金手指/系统名}","status":"{关系状态}","delta":"{变化描述}","sentiment":2}
# {"id":"REL-0002","chapter":1,"from":"{主角名}","to":"{配角名}","status":"陌生人","delta":"初次相遇，互不相识","sentiment":0}
# {"id":"REL-0003","chapter":1,"from":"{配角名}","to":"{主角名}","status":"好奇","delta":"{配角名}注意到主角的异常之处，感到好奇","sentiment":1}
