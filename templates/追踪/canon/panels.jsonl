# Schema: {"id":"PANEL-XXXX","chapter":N,"entity":"{角色名}","system":"金手指/系统名","field":"面板字段（属性/等级/经验/任务/奖励/限制）","value":"数值或规则描述","immutable":true|false,"note":"备注（可空）"}
# 用途：金手指/系统面板 immutable 注册表。网文读者对数字极敏感——面板数值前后不一致是重大翻车。
# immutable=true：该值/规则一经登记不得矛盾（如"经验值 1200"、"每日限一次"）
# immutable=false：可变值（如临时任务、当前血量），可被后续章节覆盖
# 写前 P2 加载出场角色的面板当前值；P3.5 逐条比对本章出现的面板数值/规则
# 只追加不修改；value / immutable 可更新（更新需记 canon_change_log）
# 示例条目（使用时替换为实际内容，或删除示例从头开始）：
# {"id":"PANEL-0001","chapter":1,"entity":"{主角名}","system":"{金手指名}","field":"属性-灵力","value":"12","immutable":true,"note":"初始面板"}
# {"id":"PANEL-0002","chapter":1,"entity":"{主角名}","system":"{金手指名}","field":"规则-每日任务","value":"每日 1 次，完成 +2 灵力","immutable":true,"note":"面板规则"}
# {"id":"PANEL-0003","chapter":3,"entity":"{主角名}","system":"{金手指名}","field":"属性-灵力","value":"16","immutable":false,"note":"突破后更新"}
